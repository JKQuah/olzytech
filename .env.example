# Public canonical origin: drives canonical URLs, hreflang, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=https://olzytech.com

# Optional: POST target for contact-form enquiries (Slack / Zapier / Make / CRM webhook).
# When unset, enquiries are logged on the server.
CONTACT_WEBHOOK_URL=

# Optional: search-engine ownership tags (rendered in <head> only when set).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
